@@ -2625,6 +2625,10 @@
     for (i = 0; i < ARRAY_SIZE(base_memmap); i++) {
         vms->memmap[i] = base_memmap[i];
     }
+    if (vms->ram_base) {
+        /* Watari: guest RAM at an M1-like base (all M1 RAM is above 4 GiB) */
+        vms->memmap[VIRT_MEM].base = vms->ram_base;
+    }
 
     if (ms->ram_slots > ACPI_MAX_RAM_SLOTS) {
         error_report("unsupported number of memory slots: %"PRIu64,
@@ -2662,7 +2666,8 @@
         error_report("maxmem/slots too huge");
         exit(EXIT_FAILURE);
     }
-    if (base < vms->memmap[VIRT_MEM].base + LEGACY_RAMLIMIT_BYTES) {
+    if (!vms->ram_base &&
+        base < vms->memmap[VIRT_MEM].base + LEGACY_RAMLIMIT_BYTES) {
         base = vms->memmap[VIRT_MEM].base + LEGACY_RAMLIMIT_BYTES;
     }
 
@@ -3746,6 +3751,31 @@
     }
 }
 
+static void virt_get_ram_base(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    VirtMachineState *vms = VIRT_MACHINE(obj);
+    uint64_t val = vms->ram_base ? vms->ram_base : GiB;
+
+    visit_type_uint64(v, name, &val, errp);
+}
+
+static void virt_set_ram_base(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    VirtMachineState *vms = VIRT_MACHINE(obj);
+    uint64_t val;
+
+    if (!visit_type_uint64(v, name, &val, errp)) {
+        return;
+    }
+    if (val & (GiB - 1)) {
+        error_setg(errp, "ram-base must be a multiple of 1 GiB");
+        return;
+    }
+    vms->ram_base = (val == GiB) ? 0 : val;
+}
+
