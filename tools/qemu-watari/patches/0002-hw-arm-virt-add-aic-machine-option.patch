+}
+
+static bool virt_get_aic(Object *obj, Error **errp)
+{
+    VirtMachineState *vms = VIRT_MACHINE(obj);
+
+    return vms->aic;
+}
+
+static void virt_set_aic(Object *obj, bool value, Error **errp)
+{
+    VirtMachineState *vms = VIRT_MACHINE(obj);
+
+    vms->aic = value;
+}
+
+static char *virt_get_aic_routes(Object *obj, Error **errp)
+{
+    VirtMachineState *vms = VIRT_MACHINE(obj);
+    GString *r = g_string_new("");
+
+    if (vms->aic_routes & AIC_ROUTE_RTC) {
+        g_string_append(r, "rtc");
+    }
+    if (vms->aic_routes & AIC_ROUTE_UART0) {
+        g_string_append(r, r->len ? "+uart" : "uart");
+    }
+    if (!r->len) {
+        g_string_append(r, "none");
+    }
+    return g_string_free(r, false);
+}
+
+static void virt_set_aic_routes(Object *obj, const char *value, Error **errp)
+{
+    VirtMachineState *vms = VIRT_MACHINE(obj);
+    char **tok = g_strsplit(value, "+", -1);
+    uint32_t routes = 0;
+
+    for (char **t = tok; *t; t++) {
+        if (!strcmp(*t, "rtc")) {
+            routes |= AIC_ROUTE_RTC;
+        } else if (!strcmp(*t, "uart")) {
+            routes |= AIC_ROUTE_UART0;
+        } else if (strcmp(*t, "none")) {
+            error_setg(errp, "Invalid aic-routes value '%s'", *t);
+            error_append_hint(errp, "Valid values: none, rtc, uart, joined "
+                              "with '+' (e.g. rtc+uart).\n");
+            g_strfreev(tok);
+            return;
+        }
+    }
+    g_strfreev(tok);
+    vms->aic_routes = routes;
 }
 
