+/*
+ * Watari AIC (aic=on): the GIC stays (QEMU provides the ICH_* virtual CPU interface only with
+ * it, and the M1 has ICH_* too), an Apple-style AIC is added at VIRT_WATARI_AIC and selected
+ * devices are wired to AIC inputs instead of GIC SPIs. The AIC input number of a device is its
+ * usual SPI number (RTC 2, UART0 1), so the INTID a layer exposes to the guest (32 + hwirq) is
+ * the one the FDT / ACPI already announce. The CPU IRQ line is shared by GIC and AIC through an
+ * OR gate per CPU.
+ */
+#define NUM_AIC_IRQS 128
+enum {
+    AIC_ROUTE_RTC   = 1 << 0,
+    AIC_ROUTE_UART0 = 1 << 1,
+};
+
+static qemu_irq virt_dev_irq(const VirtMachineState *vms, uint32_t route,
+                             int irq)
+{
+    if (vms->aic_dev && (vms->aic_routes & route)) {
+        return qdev_get_gpio_in(vms->aic_dev, irq);
+    }
+    return qdev_get_gpio_in(vms->gic, irq);
+}
+
+static void create_watari_aic(VirtMachineState *vms)
+{
+    MachineState *ms = MACHINE(vms);
+    hwaddr base = vms->memmap[VIRT_WATARI_AIC].base;
+    hwaddr size = vms->memmap[VIRT_WATARI_AIC].size;
+    uint32_t irqs[2];
+    unsigned n = 0;
+    char *nodename;
+    SysBusDevice *s;
+
+    vms->aic_dev = qdev_new(TYPE_WATARI_AIC);
+    qdev_prop_set_uint32(vms->aic_dev, "num-irq", NUM_AIC_IRQS);
+    qdev_prop_set_uint32(vms->aic_dev, "num-cpu", ms->smp.cpus);
+    s = SYS_BUS_DEVICE(vms->aic_dev);
+    sysbus_realize_and_unref(s, &error_fatal);
+    sysbus_mmio_map(s, 0, base);
+
+    if (vms->aic_routes & AIC_ROUTE_UART0) {
+        irqs[n++] = cpu_to_be32(vms->irqmap[VIRT_UART0]);
+    }
+    if (vms->aic_routes & AIC_ROUTE_RTC) {
+        irqs[n++] = cpu_to_be32(vms->irqmap[VIRT_RTC]);
+    }
+
+    nodename = g_strdup_printf("/watari-aic@%" PRIx64, base);
+    qemu_fdt_add_subnode(ms->fdt, nodename);
+    qemu_fdt_setprop_string(ms->fdt, nodename, "compatible", "watari,aic-v1");
+    qemu_fdt_setprop_sized_cells(ms->fdt, nodename, "reg", 2, base, 2, size);
+    qemu_fdt_setprop_cell(ms->fdt, nodename, "watari,num-irq", NUM_AIC_IRQS);
+    qemu_fdt_setprop_cell(ms->fdt, nodename, "watari,num-cpu", ms->smp.cpus);
+    if (n) {
+        qemu_fdt_setprop(ms->fdt, nodename, "watari,routed-irqs", irqs,
+                         n * sizeof(irqs[0]));
+    }
+    g_free(nodename);
+}
