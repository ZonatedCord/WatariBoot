##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = WatariM1SelfTest
  FILE_GUID                      = 7c4e1a96-d035-4b8f-82a1-5e6f09b3d4c2
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = WatariM1SelfTestMain

[Sources]
  WatariM1SelfTest.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  WatariM1Pkg/WatariM1Pkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  PrintLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  UefiRuntimeServicesTableLib

[Protocols]
  gEfiGraphicsOutputProtocolGuid                ## CONSUMES
