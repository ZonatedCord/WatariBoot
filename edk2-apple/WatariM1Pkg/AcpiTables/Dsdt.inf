[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = WatariM1Dsdt
  FILE_GUID                      = 4b1a6d2e-93c7-4f08-8e15-d62a7c39b054
  MODULE_TYPE                    = USER_DEFINED
  VERSION_STRING                 = 1.0

[Sources]
  Dsdt.asl

[Packages]
  MdePkg/MdePkg.dec
