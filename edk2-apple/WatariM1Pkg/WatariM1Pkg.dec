[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = WatariM1Pkg
  PACKAGE_GUID                   = 7d2e4b90-1c58-4a37-b6f3-0a9d58e1c426
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[Guids]
  gWatariM1TokenSpaceGuid = { 0xc61e90b3, 0x5d27, 0x4a08, { 0x9b, 0x4e, 0x71, 0xa3, 0x0f, 0xd8, 0x26, 0xc5 } }

  ## FILE_GUID of AcpiTables/Dsdt.inf: the DSDT is stored in the firmware volume as a raw section
  #  under this name and WatariM1AcpiDxe reads it from there.
  gWatariM1DsdtFileGuid = { 0x4b1a6d2e, 0x93c7, 0x4f08, { 0x8e, 0x15, 0xd6, 0x2a, 0x7c, 0x39, 0xb0, 0x54 } }

  ## Device path GUID (vendor node) of the GOP handle that WatariSimpleFbDxe installs.
  gWatariSimpleFbDevicePathGuid = { 0x91d8f3a2, 0x6b0e, 0x4c47, { 0xa5, 0x13, 0x0e, 0xc7, 0x48, 0xd2, 0x7f, 0x61 } }

  ## FILE_GUID of Application/WatariM1SelfTest/WatariM1SelfTest.inf: WatariM1BootManagerLib starts the
  #  self-test from the firmware volume under this name.
  gWatariM1SelfTestFileGuid = { 0x7c4e1a96, 0xd035, 0x4b8f, { 0x82, 0xa1, 0x5e, 0x6f, 0x09, 0xb3, 0xd4, 0xc2 } }

[PcdsFixedAtBuild]
  ## BENCH ONLY (-D WATARI_M1_BENCH_PL011=TRUE): physical address of the PL011 that the QEMU bench
  #  gives the firmware as its console. WatariM1MemInfoLib maps this one page as device memory in
  #  the PEI MMU map. Zero (the production value) = no peripheral is mapped at all.
  gWatariM1TokenSpaceGuid.PcdWatariM1BenchUartBase|0x0|UINT64|0x00000001

  ## E11, build define -D WATARI_FB_REPORT_BGR8=TRUE. TRUE: WatariSimpleFbDxe reports the 10-bit
  #  panel (format x2r10g10b10) as PixelBlueGreenRedReserved8BitPerColor, the only format Microsoft
  #  accepts for boot graphics (re/m3b-usb-display-windows.md section 7). UNTRUTHFUL: an 8-bit
  #  writer puts B in bits 7:0, G in 15:8, R in 23:16, which the panel reads as other channels
  #  (wrong colours, shapes visible; DESIGN 8.5 stage 2). FALSE (default): the truthful PixelBitMask.
  gWatariM1TokenSpaceGuid.PcdWatariFbReportBgr8|FALSE|BOOLEAN|0x00000002

  ## T16a, BENCH ONLY (-D WATARI_M1_BENCH_RAMDISK=TRUE): base address and size of the RAM that the QEMU
  #  bench fills with a disk image (-device loader) and WatariM1BenchRamDiskDxe turns into a RAM disk.
  #  Zero (the production value) = no RAM disk. The image must be exactly PcdWatariM1BenchRamDiskSize
  #  bytes (the GPT backup header is at the end of it).
  gWatariM1TokenSpaceGuid.PcdWatariM1BenchRamDiskBase|0x0|UINT64|0x00000003
  gWatariM1TokenSpaceGuid.PcdWatariM1BenchRamDiskSize|0x0|UINT64|0x00000004
