[Includes]
  Include

[Guids]
  ## FILE_GUID of AcpiTables/Dsdt.inf: the DSDT is stored in the firmware volume as a raw section
  #  under this name and WatariM1AcpiDxe reads it from there.
  gWatariM1DsdtFileGuid = { 0x4b1a6d2e, 0x93c7, 0x4f08, { 0x8e, 0x15, 0xd6, 0x2a, 0x7c, 0x39, 0xb0, 0x54 } }
